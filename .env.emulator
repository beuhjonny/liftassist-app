# Copy this to .env.local to run the app against the Firebase Emulator Suite:
#
#   cp .env.emulator .env.local
#   firebase emulators:start --only auth,firestore --project demo-liftlogic
#   npm run dev
#
# Every value here is fake. The emulator does not validate them and nothing in
# this file reaches a real Firebase project. VITE_USE_EMULATOR is the only flag
# that matters: without it the app behaves exactly as it does in production, so
# a normal build is unaffected by this file existing.
#
# .env.local itself is gitignored, which is why this checked-in copy exists.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-liftlogic.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-liftlogic
VITE_FIREBASE_STORAGE_BUCKET=demo-liftlogic.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:demolocal
VITE_USE_EMULATOR=true
